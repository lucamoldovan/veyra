# Copy to /etc/veyra/server.env (legacy deployment path retained for upgrades) and set the TLS paths for your LAN certificate.
NDIVIEW_HOST=0.0.0.0
NDIVIEW_PORT=8787
NDIVIEW_TLS_CERT_PATH=/etc/veyra/tls/server.crt
NDIVIEW_TLS_KEY_PATH=/etc/veyra/tls/server.key
NDIVIEW_COOKIE_SECURE=true
NDIVIEW_DATABASE_PATH=/var/lib/veyra/server/data/veyra.sqlite
NDIVIEW_SETUP_KEY_PATH=/var/lib/veyra/server/secrets/setup-key
NDIVIEW_PAIRING_SECRET_PATH=/var/lib/veyra/server/secrets/pairing-secret
NDIVIEW_MEDIA_DIRECTORY=/var/lib/veyra/server/media
NDIVIEW_DASHBOARD_DIRECTORY=../dashboard/dist
LOG_LEVEL=info
