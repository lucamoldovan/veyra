# Copy to /etc/veyra/server.env and set the TLS paths for your LAN certificate.
VEYRA_HOST=0.0.0.0
VEYRA_PORT=8787
VEYRA_TLS_CERT_PATH=/etc/veyra/tls/server.crt
VEYRA_TLS_KEY_PATH=/etc/veyra/tls/server.key
VEYRA_COOKIE_SECURE=true
VEYRA_DATABASE_PATH=/var/lib/veyra/server/data/veyra.sqlite
VEYRA_SETUP_KEY_PATH=/var/lib/veyra/server/secrets/setup-key
VEYRA_PAIRING_SECRET_PATH=/var/lib/veyra/server/secrets/pairing-secret
VEYRA_MEDIA_DIRECTORY=/var/lib/veyra/server/media
VEYRA_DASHBOARD_DIRECTORY=../dashboard/dist
LOG_LEVEL=info
